[Unit]
Description=CSIP gateway (read-only inverter monitor)
After=network-online.target
Wants=network-online.target

[Service]
User=csipgw
Group=csipgw
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /opt/csip-gateway/csipgw.py --config /etc/csip-gateway/config.json
Restart=always
RestartSec=5
# port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/csip-gateway

[Install]
WantedBy=multi-user.target
